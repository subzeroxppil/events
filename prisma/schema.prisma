generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model events_portal_admin {
  id    Int       @id(map: "events_portal_admin_pkey") @default(autoincrement())
  email String    @unique(map: "events_portal_admin_email_key")
  role  AdminRole
}

model events_portal_admin_user {
  id            Int      @id(map: "events_portal_admin_user_pkey") @default(autoincrement())
  email         String   @unique(map: "events_portal_admin_user_email_key")
  password_hash String
  created_at    DateTime @default(now())
}

model events_portal_attendance {
  id                  Int                  @id(map: "events_portal_attendance_pkey") @default(autoincrement())
  userId              Int
  eventId             Int
  groupNumber         Int?
  prizeId             Int?
  registeredAt        DateTime             @default(now())
  events_portal_event events_portal_event  @relation(fields: [eventId], references: [id], map: "events_portal_attendance_eventId_fkey")
  events_portal_prize events_portal_prize? @relation(fields: [prizeId], references: [id], map: "events_portal_attendance_prizeId_fkey")
  events_portal_user  events_portal_user   @relation(fields: [userId], references: [id], map: "events_portal_attendance_userId_fkey")

  @@unique([userId, eventId], map: "events_portal_attendance_userId_eventId_key")
}

model events_portal_brand {
  id                  Int                   @id(map: "events_portal_brand_pkey") @default(autoincrement())
  name                String                @unique(map: "events_portal_brand_name_key")
  events_portal_prize events_portal_prize[]
}

model events_portal_business_unit_mapping {
  email        String @id(map: "BusinessUnitMapping_pkey")
  businessUnit String
}

model events_portal_event {
  id                       Int                        @id(map: "events_portal_event_pkey") @default(autoincrement())
  name                     String
  createdAt                DateTime                   @default(now())
  eventStartTime           DateTime
  eventEndTime             DateTime
  hasLuckyDraw             Boolean                    @default(false)
  location                 String
  country                  String
  createdBy                String
  groupConfigNumber        Int?
  groupingStrategy         GroupingStrategy?
  terms                    String?
  events_portal_attendance events_portal_attendance[]
  events_portal_prize      events_portal_prize[]
}

model events_portal_prize {
  id                       Int                        @id(map: "events_portal_prize_pkey") @default(autoincrement())
  brandId                  Int
  eventId                  Int
  name                     String
  quantity                 Int                        @default(0)
  imageBlob                Bytes
  events_portal_attendance events_portal_attendance[]
  events_portal_brand      events_portal_brand        @relation(fields: [brandId], references: [id], map: "events_portal_prize_brandId_fkey")
  events_portal_event      events_portal_event        @relation(fields: [eventId], references: [id], map: "events_portal_prize_eventId_fkey")
}

model events_portal_user {
  id                       Int                        @id(map: "events_portal_user_pkey") @default(autoincrement())
  workId                   String                     @unique(map: "events_portal_user_workId_key")
  events_portal_attendance events_portal_attendance[]
  events_portal_luckydraw_winners events_portal_luckydraw_winners[]
}

enum AdminRole {
  SUPERADMIN
  EVENTADMIN
}

enum GroupingStrategy {
  roundRobin
  maxGroupCapacity
}

model events_portal_luckydraw {
  id        Int      @id(map: "events_portal_luckydraw_pkey") @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  createdBy String
  eventIds  Int[]    @default([])

  // View-only public page ("/live/<id>"): server-side on/off gate plus the
  // spin broadcast bus that the SSE stream polls.
  viewOnlyEnabled Boolean   @default(false)
  liveSpin        Json?
  liveSpinAt      DateTime?

  events_portal_luckydraw_winners events_portal_luckydraw_winners[]
}

model events_portal_luckydraw_winners {
  id           Int                     @id @default(autoincrement())
  luckydrawId  Int
  userId       Int
  createdAt        DateTime                @default(now())
  
  events_portal_luckydraw events_portal_luckydraw @relation(fields: [luckydrawId], references: [id])
  events_portal_user      events_portal_user      @relation(fields: [userId], references: [id])
  
}