generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GroupingStrategy {
  roundRobin       // Attendees assigned in order across groups (1,2,3,1,...)
  maxGroupCapacity // Groups filled up one at a time to max capacity
}

model User {
  id          Int          @id @default(autoincrement())
  workId      String       @unique

  attendances Attendance[]
}

model Event {
  id          Int          @id @default(autoincrement())
  name        String
  eventStartTime   DateTime 
  eventEndTime   DateTime
  hasLuckyDraw Boolean @default(false)
  location       String
  groupingStrategy  GroupingStrategy?
  groupConfigNumber Int?      
  country        String
  terms       String?
  createdAt   DateTime     @default(now())
  createdBy      String 

  prizes      Prize[]
  attendances Attendance[]
}

model Attendance {
  id          Int      @id @default(autoincrement())
  userId      Int
  eventId     Int
  groupNumber Int?
  prizeId     Int?
  registeredAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  event       Event    @relation(fields: [eventId], references: [id])
  prize       Prize?   @relation(fields: [prizeId], references: [id])

  @@unique([userId, eventId]) // Prevent duplicate attendance
}

model Brand {
  id     Int     @id @default(autoincrement())
  name   String  @unique

  prizes Prize[]
}

model Prize {
  id         Int     @id @default(autoincrement())
  brandId    Int
  eventId    Int
  name       String
  imageBlob   Bytes
  quantity   Int     @default(0)

  brand      Brand   @relation(fields: [brandId], references: [id])
  event      Event   @relation(fields: [eventId], references: [id])
  attendances Attendance[]
}

enum AdminRole {
  SUPERADMIN
  EVENTADMIN
}

model Admin {
  id     Int     @id @default(autoincrement())
  email  String  @unique
  role   AdminRole
}