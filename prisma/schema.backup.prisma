generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum events_portal_GroupingStrategy {
  roundRobin       // Attendees assigned in order across groups (1,2,3,1,...)
  maxGroupCapacity // Groups filled up one at a time to max capacity
}

model events_portal_user {
  id          Int          @id @default(autoincrement())
  workId      String       @unique

  attendances events_portal_attendance[]
}

model events_portal_event {
  id          Int          @id @default(autoincrement())
  name        String
  eventStartTime   DateTime 
  eventEndTime   DateTime
  hasLuckyDraw Boolean @default(false)
  location       String
  groupingStrategy  events_portal_GroupingStrategy?
  groupConfigNumber Int?      
  country        String
  terms       String?
  createdAt   DateTime     @default(now())
  createdBy      String 

  prizes      events_portal_prize[]
  attendances events_portal_attendance[]
}

model events_portal_attendance {
  id          Int      @id @default(autoincrement())
  userId      Int
  eventId     Int
  groupNumber Int?
  prizeId     Int?
  registeredAt DateTime @default(now())

  user        events_portal_user     @relation(fields: [userId], references: [id])
  event       events_portal_event    @relation(fields: [eventId], references: [id])
  prize       events_portal_prize?   @relation(fields: [prizeId], references: [id])

  @@unique([userId, eventId]) // Prevent duplicate attendance
}

model events_portal_brand {
  id     Int     @id @default(autoincrement())
  name   String  @unique

  prizes events_portal_prize[]
}

model events_portal_prize {
  id         Int     @id @default(autoincrement())
  brandId    Int
  eventId    Int
  name       String
  imageBlob   Bytes
  quantity   Int     @default(0)

  brand      events_portal_brand   @relation(fields: [brandId], references: [id])
  event      events_portal_event   @relation(fields: [eventId], references: [id])
  attendances events_portal_attendance[]
}

enum events_portal_AdminRole {
  SUPERADMIN
  EVENTADMIN
}

model events_portal_admin {
  id     Int     @id @default(autoincrement())
  email  String  @unique
  role   events_portal_AdminRole
}

model events_portal_business_unit_mapping {
  email         String   @id
  businessUnit  String
}

model events_portal_admin_user {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String          @map("password_hash")
  createdAt      DateTime        @default(now()) @map("created_at")
}